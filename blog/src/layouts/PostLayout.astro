---
import BaseLayout from './BaseLayout.astro';
import SEOHead from '../components/SEOHead.astro';
import AuthorBadge from '../components/AuthorBadge.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ServiceCTA from '../components/ServiceCTA.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { absoluteUrl, formatDate, readingTime } from '../lib/posts';
const { post, headings, previous, next, related } = Astro.props;
const d = post.data; const path = `/blog/${post.id}/`; const minutes = readingTime(post.body);
const articleLd = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.description,
  image: absoluteUrl(d.cover), datePublished: d.publishedAt.toISOString(), dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
  mainEntityOfPage: absoluteUrl(path), author: { '@type': 'Person', name: d.author },
  publisher: { '@type': 'Organization', name: 'GPY Soluções', logo: { '@type': 'ImageObject', url: absoluteUrl('/blog/logo.svg') } },
};
const breadcrumbLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Início', item: absoluteUrl('/') },
  { '@type': 'ListItem', position: 2, name: 'Blog', item: absoluteUrl('/blog/') },
  { '@type': 'ListItem', position: 3, name: d.title, item: absoluteUrl(path) },
]};
---
<BaseLayout>
  <SEOHead slot="head" title={`${d.title} | GPY Soluções`} description={d.description} canonicalPath={path} image={d.cover} type="article" publishedAt={d.publishedAt} updatedAt={d.updatedAt ?? d.publishedAt} author={d.author} jsonLd={[articleLd, breadcrumbLd]} />
  <article>
    <header class="article-hero shell">
      <nav class="breadcrumbs" aria-label="Navegação estrutural"><a href="/">Início</a><span>/</span><a href="/blog">Blog</a><span>/</span><span>{d.category}</span></nav>
      <CategoryBadge category={d.category} />
      <h1>{d.title}</h1>
      <p class="article-deck">{d.description}</p>
      <div class="article-meta"><AuthorBadge author={d.author} /><span>{formatDate(d.publishedAt)}<small>Atualizado em {formatDate(d.updatedAt ?? d.publishedAt)} · {minutes} min de leitura</small></span><ShareButtons title={d.title} url={absoluteUrl(path)} /></div>
    </header>
    <div class="article-cover shell"><img src={d.cover} alt={d.coverAlt} width="1280" height="720" /></div>
    <div class="article-layout shell">
      <TableOfContents headings={headings} />
      <div class="prose"><slot /></div>
    </div>
  </article>
  <div class="shell"><ServiceCTA /></div>
  <nav class="post-navigation shell" aria-label="Artigos anterior e próximo">
    {previous ? <a href={`/blog/${previous.id}/`}><span>← Artigo anterior</span><strong>{previous.data.title}</strong></a> : <span></span>}
    {next && <a class="next" href={`/blog/${next.id}/`}><span>Próximo artigo →</span><strong>{next.data.title}</strong></a>}
  </nav>
  <RelatedPosts posts={related} />
  <script is:inline>
    document.querySelectorAll('pre').forEach((pre) => { const button = document.createElement('button'); button.className = 'copy-code'; button.type = 'button'; button.textContent = 'Copiar'; button.addEventListener('click', async () => { await navigator.clipboard.writeText(pre.innerText); button.textContent = 'Copiado'; setTimeout(() => button.textContent = 'Copiar', 1500); }); pre.appendChild(button); });
  </script>
</BaseLayout>
