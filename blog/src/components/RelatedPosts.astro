---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/posts';
const { posts } = Astro.props as { posts: Post[] };
---
{posts.length > 0 && <section class="related shell"><div class="section-heading"><span class="eyebrow">Continue explorando</span><h2>Artigos relacionados</h2></div><div class="post-grid">{posts.map((post) => <PostCard post={post} />)}</div></section>}
