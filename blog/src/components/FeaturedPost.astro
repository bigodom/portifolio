---
import CategoryBadge from './CategoryBadge.astro';
import AuthorBadge from './AuthorBadge.astro';
import ReadingTime from './ReadingTime.astro';
import { formatDate, readingTime } from '../lib/posts';
const { post } = Astro.props;
---
<article class="featured-post">
  <a class="featured-image" href={`/blog/${post.id}/`}><img src={post.data.cover} alt={post.data.coverAlt} width="960" height="680" /><span>Leitura em destaque</span></a>
  <div class="featured-content">
    <CategoryBadge category={post.data.category} />
    <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <div class="featured-meta"><AuthorBadge author={post.data.author} /><span>{formatDate(post.data.publishedAt)}<br /><ReadingTime minutes={readingTime(post.body)} /></span></div>
    <a class="text-link" href={`/blog/${post.id}/`}>Ler artigo <span>→</span></a>
  </div>
</article>
